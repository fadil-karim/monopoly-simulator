/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# Fonts never change - cache them hard.
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Scripts and styles are revalidated on every load (a cheap 304 when unchanged),
# because the modules import each other by name and a deploy must reach them all.
/assets/app/*
  Cache-Control: public, max-age=0, must-revalidate
/assets/style/*
  Cache-Control: public, max-age=0, must-revalidate

# The models' logos on the tokens change rarely: a day in the cache, never immutable.
/assets/logos/*
  Cache-Control: public, max-age=86400

# HTML must stay fresh so a deploy is visible immediately.
/*.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate

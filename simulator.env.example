# The simulator's keys and the site's token, for the container: copy this file to simulator.env (ignored by git) and
# fill in what you use; docker-compose.yml hands it to the container. The dashboard can take all of these instead and
# remember them in the data volume. Never commit the filled-in file.
SITE=https://monopoly.basilicalabs.ai
RUNNER_TOKEN=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
PERPLEXITY_API_KEY=
OPENROUTER_API_KEY=
# Any other provider in the pool takes its own: OPENAI_API_KEY, XAI_API_KEY, MISTRAL_API_KEY, DEEPSEEK_API_KEY,
# MOONSHOT_API_KEY, ZAI_API_KEY, XIAOMI_API_KEY, ...
# The dashboard asks for this password when it is set (any user name):
# DASHBOARD_PASSWORD=

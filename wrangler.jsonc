{
  // The site: the viewer in public/ served as static assets, and src/worker.js
  // for everything under /api/ (the match history in D1, the runner's uploads,
  // the narrator). https://developers.cloudflare.com/workers/static-assets/
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "monopoly-simulator",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Serve the themed 404 for unknown paths instead of a bare Cloudflare error.
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true
  },
  // The database. No id is needed: the deploy creates a D1 database named
  // monopoly-ai in the account, or connects to the one of that name already
  // there, and binds it, and later deploys keep it (wrangler's automatic
  // provisioning). The Worker applies the migrations itself on first use. The
  // one step left to the owner is the runner's token, set once as a secret, in
  // the Worker's Settings in the Cloudflare dashboard or with
  //
  //   npx wrangler secret put RUNNER_TOKEN
  //
  "d1_databases": [
    { "binding": "DB", "database_name": "monopoly-ai", "migrations_dir": "migrations" }
  ],
  // Local development and the test suite use this environment with a simulated database:
  //   npx wrangler d1 migrations apply DB --local --env local
  //   npx wrangler dev --env local
  "env": {
    "local": {
      "vars": { "RUNNER_TOKEN": "local-dev-token" },
      "d1_databases": [
        { "binding": "DB", "database_name": "monopoly-ai", "database_id": "local", "migrations_dir": "migrations" }
      ]
    }
  }
}
